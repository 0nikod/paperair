---
/**
 * 全站搜索组件
 * 基于 Pagefind 实现的静态全文搜索功能。
 * 包含搜索输入框、结果展示面板、搜索计数以及按时间筛选的过滤功能。
 */
import { Icon } from "astro-icon/components";

interface Props {
  /** 自定义样式类 */
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<site-search class={`form-control min-w-0 ${className}`} data-state="closed">
  <button
    type="button"
    class="search-trigger btn btn-ghost btn-circle btn-sm h-11 w-11 sm:h-9 sm:w-9"
    aria-label="打开搜索"
    aria-expanded="false"
    aria-controls="site-search-input"
    data-search-trigger
  >
    <Icon name="ri:search-line" class="h-5 w-5" />
  </button>

  <div class="search-field relative" data-search-field>
    <label class="relative flex min-w-0 items-center">
      <span class="sr-only">搜索</span>
      <Icon
        name="ri:search-line"
        class="pointer-events-none absolute left-3 h-4 w-4 text-base-content/40"
      />
      <input
        id="site-search-input"
        type="search"
        placeholder="搜索..."
        class="input input-sm h-11 w-36 min-w-0 rounded-full border-transparent bg-base-200/80 pl-9 pr-9 text-sm shadow-inner transition-colors hover:bg-base-200 focus:border-primary focus:bg-base-100 focus:outline-none focus:ring-2 focus:ring-primary/30 sm:h-9 sm:w-48 lg:w-56"
        data-search-input
        autocomplete="off"
      />
      <button
        type="button"
        class="btn btn-ghost btn-circle btn-xs absolute right-1 h-8 w-8"
        aria-label="关闭搜索"
        data-search-close
      >
        <Icon name="ri:close-line" class="h-4 w-4" />
      </button>
    </label>

    <!-- 搜索结果下拉面板 -->
    <div
      class="fixed inset-x-4 top-18 z-50 hidden rounded-box border border-base-300 bg-base-100 shadow-xl sm:absolute sm:inset-x-auto sm:right-0 sm:top-full sm:mt-2 sm:w-md sm:max-w-[calc(100vw-2rem)]"
      data-search-results
    >
      <!-- 头部栏 -->
      <div
        class="flex items-center justify-between px-3 py-2 border-b border-base-200"
        data-search-header
      >
        <span class="text-xs font-medium text-base-content/60" data-search-count
          >0 个结果</span
        >

        <!-- 筛选下拉菜单 (气泡/胶囊面板) -->
        <div class="dropdown dropdown-end">
          <button
            tabindex="0"
            class="btn btn-ghost btn-xs text-base-content/60 hover:bg-base-200"
          >
            <Icon name="ri:filter-3-line" class="w-3 h-3" />
            <span>筛选</span>
          </button>

          <div
            tabindex="0"
            class="dropdown-content z-60 menu p-3 shadow-xl bg-base-100 rounded-box w-64 mt-2 border border-base-200"
          >
            <!-- 时间筛选 (年月) -->
            <div class="mb-2">
              <h4
                class="text-xs font-semibold text-base-content/50 uppercase tracking-wider mb-2 flex justify-between items-center"
              >
                <span>时间筛选</span>
                <button
                  type="button"
                  class="btn btn-ghost btn-xs text-base-content/50 hover:text-error px-1 hidden"
                  data-filter-time-clear
                  title="清除时间筛选"
                >
                  清除
                </button>
              </h4>
              <input
                type="month"
                class="input input-bordered input-xs w-full text-base-content/80"
                data-filter-time
                lang="zh-CN"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- 结果列表 -->
      <ul
        class="menu menu-sm max-h-[calc(100dvh-9rem)] overflow-y-auto p-2 sm:max-h-128"
        data-search-list
      >
      </ul>
    </div>
  </div>
</site-search>

<style>
  site-search {
    display: flex;
    align-items: center;
  }

  .search-trigger {
    overflow: hidden;
    transition:
      width 200ms ease,
      min-width 200ms ease,
      padding 200ms ease,
      opacity 150ms ease,
      transform 200ms ease;
  }

  .search-field {
    width: 0;
    max-width: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(0.5rem) scale(0.96);
    transform-origin: right center;
    transition:
      width 220ms ease,
      max-width 220ms ease,
      opacity 150ms ease,
      transform 220ms ease,
      visibility 0s linear 220ms;
  }

  site-search[data-state="open"] .search-trigger {
    width: 0;
    min-width: 0;
    padding-inline: 0;
    border-width: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateX(0.5rem) scale(0.8);
  }

  site-search[data-state="open"] .search-field {
    width: 9rem;
    max-width: 9rem;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0) scale(1);
    transition:
      width 220ms ease,
      max-width 220ms ease,
      opacity 180ms 40ms ease,
      transform 220ms ease,
      visibility 0s;
  }

  @media (min-width: 40rem) {
    site-search[data-state="open"] .search-field {
      width: 12rem;
      max-width: 12rem;
    }
  }

  @media (min-width: 64rem) {
    site-search[data-state="open"] .search-field {
      width: 14rem;
      max-width: 14rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-trigger,
    .search-field {
      transition: none;
    }
  }
</style>

<script>
  import { search } from "@utils/pagefinder";

  class SiteSearch extends HTMLElement {
    private trigger: HTMLButtonElement;
    private closeBtn: HTMLButtonElement;
    private input: HTMLInputElement;
    private panel: HTMLElement;
    private list: HTMLElement;
    private countSpan: HTMLElement;
    private timeInput: HTMLInputElement;
    private timeClearBtn: HTMLButtonElement;
    private debounceTimer: ReturnType<typeof setTimeout> | null = null;
    private currentTime: string = ""; // Format: "YYYY-MM" or ""

    constructor() {
      super();
      this.trigger = this.querySelector("[data-search-trigger]")!;
      this.closeBtn = this.querySelector("[data-search-close]")!;
      this.input = this.querySelector("[data-search-input]")!;
      this.panel = this.querySelector("[data-search-results]")!;
      this.list = this.querySelector("[data-search-list]")!;
      this.countSpan = this.querySelector("[data-search-count]")!;
      this.timeInput = this.querySelector("[data-filter-time]")!;
      this.timeClearBtn = this.querySelector("[data-filter-time-clear]")!;

      // 绑定方法，以便可以由 removeEventListener 卸载
      this.handleDocumentClick = this.handleDocumentClick.bind(this);
      this.handleKeydown = this.handleKeydown.bind(this);
    }

    connectedCallback() {
      this.trigger.addEventListener("click", () => this.openSearch());
      this.closeBtn.addEventListener("click", () => this.closeSearch());
      document.addEventListener("keydown", this.handleKeydown);

      // 输入事件 — 带 300ms 防抖
      this.input.addEventListener("input", () => {
        if (this.debounceTimer) clearTimeout(this.debounceTimer);

        const query = this.input.value.trim();
        if (query.length > 1) {
          this.panel.classList.remove("hidden");
        } else {
          this.panel.classList.add("hidden");
        }

        this.debounceTimer = setTimeout(() => this.doSearch(), 300);
      });

      // 聚焦时展开面板
      this.input.addEventListener("focus", () => {
        if (this.input.value.trim().length > 1) {
          this.panel.classList.remove("hidden");
        }
      });

      // 点击外部关闭
      document.addEventListener("click", this.handleDocumentClick);

      // 原生月份选择器
      if (this.timeInput) {
        this.timeInput.addEventListener("change", () => {
          this.currentTime = this.timeInput.value; // ex: "2024-03"
          if (this.currentTime) {
            this.timeClearBtn.classList.remove("hidden");
          } else {
            this.timeClearBtn.classList.add("hidden");
          }
          this.doSearch();
        });
      }

      // 清除时间按钮
      if (this.timeClearBtn) {
        this.timeClearBtn.addEventListener("click", () => {
          this.timeInput.value = "";
          this.currentTime = "";
          this.timeClearBtn.classList.add("hidden");
          this.doSearch();
        });
      }
    }

    disconnectedCallback() {
      // 防止内存泄漏，移除挂载在全局 document 上的事件监听
      document.removeEventListener("click", this.handleDocumentClick);
      document.removeEventListener("keydown", this.handleKeydown);
    }

    private openSearch() {
      this.dataset.state = "open";
      this.trigger.setAttribute("aria-expanded", "true");
      this.input.focus();

      if (this.input.value.trim().length > 1) {
        this.panel.classList.remove("hidden");
      }
    }

    private closeSearch(restoreFocus = true) {
      this.dataset.state = "closed";
      this.panel.classList.add("hidden");
      this.trigger.setAttribute("aria-expanded", "false");
      if (restoreFocus) this.trigger.focus();
    }

    private handleDocumentClick(e: MouseEvent) {
      if (!this.contains(e.target as Node) && this.dataset.state === "open") {
        this.closeSearch(false);
      }
    }

    private handleKeydown(e: KeyboardEvent) {
      if (e.key === "Escape" && this.dataset.state === "open") {
        this.closeSearch();
      }
    }

    private async doSearch() {
      const query = this.input.value.trim();
      if (query.length < 2) {
        this.list.innerHTML = "";
        this.countSpan.textContent = "0 个结果";
        return;
      }

      // 解析 YYYY-MM
      let yearParam = "all";
      let monthParam = "all";
      if (this.currentTime) {
        yearParam = this.currentTime.substring(0, 4);
        monthParam = this.currentTime;
      }

      const results = await search(query, "all", yearParam, monthParam);

      this.list.innerHTML = "";
      this.countSpan.textContent = `${results.length} 个结果`;

      if (results.length === 0) {
        this.list.appendChild(this.createEmpty("未找到相关结果"));
        return;
      }

      for (const item of results) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = item.url;
        a.className = "flex flex-col gap-1 items-start py-2";
        a.innerHTML = `
          <span class="flex items-center gap-2">
            <span class="badge badge-xs ${
              item.type === "blog" ? "badge-primary" : "badge-secondary"
            }">${item.type === "blog" ? "文章" : "动态"}</span>
            <span class="font-medium text-base-content text-sm line-clamp-1">${
              item.title
            }</span>
          </span>
          <span class="text-xs text-base-content/50 line-clamp-2 [&>mark]:bg-primary/20 [&>mark]:text-base-content">${
            item.excerpt
          }</span>
        `;
        li.appendChild(a);
        this.list.appendChild(li);
      }
    }

    private createEmpty(text: string): HTMLLIElement {
      const li = document.createElement("li");
      li.className = "px-3 py-6 text-center text-base-content/40 text-sm";
      li.textContent = text;
      return li;
    }
  }

  customElements.define("site-search", SiteSearch);
</script>
