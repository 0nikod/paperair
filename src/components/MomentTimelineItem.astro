---
/**
 * 动态时间轴单项组件
 * 在时间轴中展示完整的动态内容，包括文字（Markdown 渲染）和图片。
 * 支持内容超长折叠、展开功能，以及生成动态的单页链接。
 */
import type { CollectionEntry } from "astro:content";
import ClientDate from "@components/ClientDate.astro";
import MomentCard from "@components/MomentCard.astro";
import { getDateParts } from "@utils/date";

interface Props {
  /** 动态条目数据 */
  moment: CollectionEntry<"moments">;
  /** 自定义样式类 */
  class?: string;
  /** 是否为时间轴的最后一项（用于控制垂直延伸线的显示） */
  isLast?: boolean;
}

const { moment, class: className, isLast = false } = Astro.props;

const date = moment.data.pubDate;
const { year, month } = getDateParts(date);
---

<article class:list={["flex gap-2 sm:gap-3 w-full relative group", className]}>
  {/* Timeline column with dot and vertical line */}
  <div class="w-6 sm:w-8 shrink-0 flex flex-col items-center relative">
    {/* Timeline Dot */}
    <div
      class="relative z-10 w-4 h-4 mt-2 rounded-full border-2 border-primary bg-base-100 shrink-0 flex items-center justify-center group-hover:bg-primary/20 transition-colors duration-300"
      aria-hidden="true"
    >
    </div>

    {/* Timeline vertical line */}
    {
      !isLast && (
        <div
          class="absolute left-1/2 -translate-x-1/2 top-10 -bottom-10 w-px bg-base-300"
          aria-hidden="true"
        />
      )
    }
  </div>

  <span data-pagefind-filter={`year:${year}`} class="hidden"></span>
  <span data-pagefind-filter={`month:${year}-${month}`} class="hidden"></span>

  {/* Content Area */}
  <div class="grow min-w-0 pb-10">
    {/* 访问者浏览器本地日期与时间；归档筛选仍使用上方的站点时区字段。 */}
    <ClientDate
      date={date}
      format="datetime"
      class="block mb-2 pt-1 text-sm md:text-base font-bold text-base-content/80"
    />

    {/* Card Content (Extracted to MomentCard) */}
    <MomentCard moment={moment} />
  </div>
</article>
