---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import MomentTimeline from "@components/MomentTimeline.astro";
import MomentsIndexLayout from "@layouts/MomentsIndexLayout.astro";
import { buildMomentArchives, filterMomentsByArchive } from "@utils/moments";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  const allMoments = await getCollection("moments");

  const paths = buildMomentArchives(allMoments).map(({ year }) => ({
    params: { year },
    props: { allMoments },
  }));

  return paths;
}

interface Props {
  allMoments: CollectionEntry<"moments">[];
}

const { year = "" } = Astro.params;
const { allMoments } = Astro.props;
const sortedMoments = filterMomentsByArchive(allMoments, year);

const title = `${year}年 - 动态归档`;
const description = `查看${year}年的动态记录。`;
---

<MomentsIndexLayout
  title={title}
  description={description}
  allMoments={allMoments}
  activeYear={year}
  mobileDropdownText={`归档: ${year}年`}
>
  <h1 slot="header" class="text-3xl font-bold mb-8 flex items-center gap-3">
    <Icon name="ri:time-line" class="text-primary w-8 h-8" />
    {year}年的动态 ({sortedMoments.length})
  </h1>

  <MomentTimeline moments={sortedMoments} emptyText="该年无动态" />
</MomentsIndexLayout>
