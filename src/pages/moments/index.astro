---
import MomentTimeline from "@components/MomentTimeline.astro";
import MomentsIndexLayout from "@layouts/MomentsIndexLayout.astro";
import { getPublishedMoments } from "@utils/content";

const title = "动态 - PaperAir";
const description = "这里记录了我的日常与瞬间。";

const allMoments = await getPublishedMoments();
---

<MomentsIndexLayout
  title={title}
  description={description}
  allMoments={allMoments}
>
  <MomentTimeline
    moments={allMoments}
    emptyText="暂无动态"
    emptyIcon="ri:ghost-line"
  />
</MomentsIndexLayout>
