---
import type { CollectionEntry } from "astro:content";
import MomentsFilter from "@components/MomentsFilter.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  allMoments: CollectionEntry<"moments">[];
  activeYear?: string | undefined;
  activeMonth?: string | undefined;
  mobileDropdownText?: string | undefined;
}

const {
  title,
  description,
  allMoments,
  activeYear,
  activeMonth,
  mobileDropdownText = "归档导航",
} = Astro.props;
---

<BaseLayout title={title} description={description} mainClass="max-w-6xl">
  <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 py-6 sm:py-8 w-full">
    {/* Sidebar Filter */}
    <aside class="w-full lg:w-64 shrink-0 order-1 lg:order-2">
      <div class="sticky top-20">
        <MomentsFilter
          moments={allMoments}
          activeYear={activeYear}
          activeMonth={activeMonth}
          class="hidden lg:block"
        />
        <div class="lg:hidden dropdown w-full">
          <div
            tabindex="0"
            role="button"
            class="btn btn-outline w-full justify-between"
          >
            <span class="flex items-center gap-2">
              <Icon name="ri:calendar-2-line" class="w-5 h-5" />
              {mobileDropdownText}
            </span>
            <Icon name="ri:arrow-down-s-line" class="w-4 h-4" />
          </div>
          <div
            tabindex="0"
            class="dropdown-content z-10 menu p-2 shadow-xl bg-base-100 rounded-box w-full mt-2 border border-base-200 max-h-[min(70vh,32rem)] overflow-y-auto"
          >
            <MomentsFilter
              moments={allMoments}
              activeYear={activeYear}
              activeMonth={activeMonth}
            />
          </div>
        </div>
      </div>
    </aside>

    {/* Main Timeline Content */}
    <div class="grow min-w-0 w-full max-w-3xl order-2 lg:order-1" data-pagefind-body>
      <span data-pagefind-filter="type:moment" class="hidden"></span>
      <slot name="header">
        <h1 class="text-2xl sm:text-3xl font-extrabold mb-8 sm:mb-10 flex items-center gap-3">
          <Icon name="ri:time-line" class="text-primary w-8 h-8" />
          动态
        </h1>
      </slot>

      <slot />
    </div>
  </div>
</BaseLayout>
