{
  "name": "paperair",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync-content": "tsx scripts/sync-content.ts",
    "predev": "pnpm sync-content",
    "prebuild": "pnpm sync-content",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:astro": "astro check",
    "check:biome": "biome check .",
    "check": "pnpm check:astro && pnpm check:biome",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "astro-icon": "^1.1.5",
    "astro-pagefind": "^2.0.1",
    "daisyui": "^5.7.16",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@iconify-json/ri": "^1.2.10",
    "decap-server": "^3.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "lint-staged": {
    "**/*.{astro,js,jsx,ts,tsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
